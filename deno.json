{
  "tasks": {
    "check": "deno check functions/*.ts functions/_shared/*.ts schemas/*.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "test": "deno test functions/_shared/",
    "ci": "deno task fmt:check && deno task lint && deno task check && deno task test"
  },
  "fmt": {
    "include": ["functions/", "schemas/", "deno.json"],
    "lineWidth": 120
  },
  "lint": {
    "include": ["functions/", "schemas/"],
    "rules": {
      "exclude": ["no-import-prefix"]
    }
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.window"]
  }
}
