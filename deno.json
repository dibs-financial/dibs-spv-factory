{
  "tasks": {
    "check": "deno check supabase/functions/*/index.ts supabase/functions/_shared/*.ts schemas/*.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "test": "deno test --allow-env supabase/functions/_shared/",
    "ci": "deno task fmt:check && deno task lint && deno task check && deno task test"
  },
  "fmt": {
    "include": [
      "supabase/functions/",
      "schemas/",
      "deno.json"
    ],
    "lineWidth": 120
  },
  "lint": {
    "include": [
      "supabase/functions/",
      "schemas/"
    ],
    "rules": {
      "exclude": [
        "no-import-prefix"
      ]
    }
  },
  "compilerOptions": {
    "strict": true,
    "lib": [
      "deno.window"
    ]
  }
}
