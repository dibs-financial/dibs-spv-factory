# DIBS SPV Factory — Lovable Cloud secrets (Supabase edge function secrets).
#
# Set them in Lovable: project → Cloud → Secrets, one entry per line below.
# Or from a terminal with the Supabase CLI: scripts/lovable-secrets.sh <project-ref>
#
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected
# automatically by Lovable Cloud and must not be set here.

# Public base URL of the factory functions: https://<project-ref>.supabase.co/functions/v1
SPVFACTORY_BASE_URL=https://<project-ref>.supabase.co/functions/v1

# Key that clients send to call the factory.
#   Frontend / another Lovable app on behalf of a signed-in user → the anon key (plus the user's JWT).
#   Server-to-server (pg_cron, backend services)                → the service role key. Never ship it to a browser.
# Both are under Cloud → Settings → API keys.
SPVFACTORY_API_KEY=<anon-or-service-role-key>

# Stable identifier for this factory installation. The factory is single-tenant;
# this value is reported by factoryInfo and stamped on nothing else. Keep it constant.
SPVFACTORY_TENANT_ID=37906dcf-1d2c-47ae-a2a0-f6e9ae1ca98d

# Environment label reported by factoryInfo: production | staging | preview
SPVFACTORY_ENV=production

# Browser origins allowed to call the functions. Unset = "*" (Lovable preview). Set in production.
DIBS_CORS_ORIGINS=https://your-app.lovable.app,https://app.dibs.financial

# Roles (public.user_roles) allowed to call factory functions with a user JWT. Comma-separated.
DIBS_FUNCTION_ALLOWED_ROLES=admin

# Optional per-signatory monthly EIN cap; leave unset for no cap.
# DIBS_EIN_MONTHLY_CAP=
